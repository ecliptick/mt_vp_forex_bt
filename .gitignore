# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- large / binary data (never commit) ----
# Engine artifact caches: notebooks/.cache holds pickled artifacts
# (~28 GB) rebuilt on demand by the sweep driver.
notebooks/.cache/
*.pkl
*.npz
*.npy
*.parquet
*.feather
*.h5
*.hdf5
*.arrow
*.bin
*.idx

# ---- sweep / diagnostic report artifacts (large JSON ledgers) ----
runtime/sweeps/_results/
runtime/diagnostics/_reports/
runtime/diagnostics/_artifacts/
runtime/parity/_artifacts/
*_ledger*.json
*.log

# ---- THE RESULTS REGISTRY (committed) ----
# results/ IS the durable, commit-stamped record of every measurement.
# It must be tracked — a result that is not in git is not a result.
# The `*_ledger*.json` pattern above would swallow
# results/runs/leg_ledger-*.json, so it is re-included here.
!results/
!results/index.json
!results/runs/
!results/runs/*.json

# ---- local scratch ----
nul
0
_chart_*.txt
_chart_*.npy
_*.bak
*.bak_*
AGENTS.md.bak_*
_trail_*.txt

# ---- editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- data files (keep local, not in git) ----
*.csv
*.xlsx
*.xls
*.zip
*.7z
*.tar.gz
